@@ -0,0 +1,115 @@
+"""Read-only S40 status and climate sensors."""
+from copy import deepcopy
+from datetime import datetime, timezone
+
+from homeassistant.components.sensor import SensorEntity, SensorDeviceClass, SensorStateClass
+from homeassistant.const import UnitOfTemperature
+from homeassistant.helpers.update_coordinator import CoordinatorEntity
+
+from .const import DOMAIN
+
+FIELDS = (
+    ("state", "Betriebszustand (Rohwert)", "mdi:information-outline"),
+    ("mode", "Betriebsmodus (Rohwert)", "mdi:tune"),
+    ("lgtLv", "Lichtstufe (Rohwert)", "mdi:lightbulb-outline"),
+    ("dfanLv", "Luefterstufe (Rohwert)", "mdi:fan"),
+    ("heaterLv", "Heizstufe (Rohwert)", "mdi:radiator"),
+    ("wtpumpLv", "Pumpenstufe (Rohwert)", "mdi:water-pump"),
+    ("connected", "Geraeteverbindung (Cloudmeldung)", "mdi:cloud-check-outline"),
+)
+
+MEASUREMENTS = (
+    ("rTemp", "Wurzeltemperatur", UnitOfTemperature.CELSIUS, SensorDeviceClass.TEMPERATURE),
+    ("pTemp", "Lufttemperatur", UnitOfTemperature.CELSIUS, SensorDeviceClass.TEMPERATURE),
+    ("pHumi", "Luftfeuchtigkeit", "%", SensorDeviceClass.HUMIDITY),
+    ("pVpd", "VPD", "kPa", None),
+    ("rssi", "WLAN-Signalstaerke", "dBm", SensorDeviceClass.SIGNAL_STRENGTH),
+)
+
+
+async def async_setup_entry(hass, entry, async_add_entities):
+    coordinator = hass.data[DOMAIN][entry.entry_id].coordinator
+    async_add_entities([
+        S40Sensor(coordinator, key, name, icon)
+        for key, name, icon in FIELDS
+    ] + [S40Measurement(coordinator, *item) for item in MEASUREMENTS])
+
+
+class S40Sensor(CoordinatorEntity, SensorEntity):
+    _attr_has_entity_name = True
+
+    def __init__(self, coordinator, key, name, icon):
+        super().__init__(coordinator)
+        self._key = key
+        self._attr_name = name
+        self._attr_icon = icon
+        device = coordinator.device
+        self._attr_unique_id = f"vivosun_s40_{device.device_id}_{key}_raw"
+        self._attr_device_info = {
+            "identifiers": {(DOMAIN, device.device_id)},
+            "manufacturer": "VIVOSUN",
+            "model": "VSeed S40 (VSSBS40)",
+            "name": "VSeed S40",
+        }
+
+    @property
+    def available(self):
+        return self.coordinator.report_available
+
+    @property
+    def native_value(self):
+        report = self.coordinator.reported
+        if self._key == "connected":
+            value = report.get("connected")
+            return ("verbunden" if value else "getrennt") if type(value) is bool else None
+        seed = report.get("seed")
+        value = seed.get(self._key) if isinstance(seed, dict) else None
+        return value if type(value) in (int, float) else None
+
+    @property
+    def extra_state_attributes(self):
+        result = {
+            "quelle": "AWS Shadow reported; zuletzt gemeldeter Zustand",
+            "cloud_antwort_empfangen": self.coordinator.report_received_at,
+            "shadow_version": self.coordinator.shadow_version,
+            "nur_lesen": True,
+        }
+        if self._key == "state":
+            seed = self.coordinator.reported.get("seed", {})
+            if isinstance(seed, dict):
+                for key in ("curParams", "stage1", "stage2", "stage3"):
+                    if isinstance(seed.get(key), dict):
+                        result[f"{key}_rohwerte"] = deepcopy(seed[key])
+        return result
+
+
+class S40Measurement(S40Sensor):
+    def __init__(self, coordinator, key, name, unit, device_class):
+        super().__init__(coordinator, key, name, "mdi:chart-line")
+        self._attr_unique_id = f"vivosun_s40_{coordinator.device.device_id}_{key}_measurement"
+        self._attr_native_unit_of_measurement = unit
+        self._attr_device_class = device_class
+        self._attr_state_class = SensorStateClass.MEASUREMENT
+        self._attr_suggested_display_precision = 0 if key == "rssi" else 2
+
+    @property
+    def available(self):
+        return self.coordinator.telemetry_available(self._key)
+
+    @property
+    def native_value(self):
+        return self.coordinator.telemetry.get("values", {}).get(self._key)
+
+    @property
+    def extra_state_attributes(self):
+        stamp = self.coordinator.telemetry.get("sample_time")
+        return {
+            "quelle": "VIVOSUN Messwerthistorie",
+            "messzeitpunkt": (
+                datetime.fromtimestamp(stamp, timezone.utc).isoformat()
+                if stamp is not None else None
+            ),
+            "nur_lesen": True,
+        }
+
+# ENDE DER DATEI
