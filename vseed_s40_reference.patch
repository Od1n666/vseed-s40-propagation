+++ b/examples/vseed_s40_local_reference/s40_control.py
@@ -0,0 +1,365 @@
+"""Restricted S40 phase, setting and manual flood commands."""
+import asyncio
+import json
+from uuid import uuid4
+
+from homeassistant.exceptions import HomeAssistantError, ServiceValidationError
+
+from .mqtt_client import MQTTClient
+from .s40_status import S40StatusCoordinator
+from .vseed_readonly import ReadOnlyMQTT
+
+
+PHASES = {"Keimung": 1, "Aussaat": 2, "Saemling": 3}
+OPERATIONS = {"Aus": 0, **PHASES}
+
+LIMITS = {
+    "tTemp": (2000, 3200, 10),
+    "tHumi": (100, 9900, 100),
+    "lgtLv": (25, 100, 1),
+    "lgtOnDur": (0, 86400, 1800),
+    "lgtEn": (0, 1, 1),
+    "pumpEn": (0, 1, 1),
+    "pumpMode": (1, 2, 1),
+}
+
+
+def allowed(path, value):
+    if type(value) is not int:
+        return False
+    if path == ("quickAct", "waterTime"):
+        return value in (0, 600)
+    if path == ("state",):
+        return value in (0, 1, 2, 3)
+    if (
+        len(path) != 2
+        or path[0] not in ("stage1", "stage2", "stage3")
+    ):
+        return False
+    rule = LIMITS.get(path[1])
+    return bool(
+        rule
+        and rule[0] <= value <= rule[1]
+        and value % rule[2] == 0
+    )
+
+
+def read_path(data, path):
+    for key in path:
+        if not isinstance(data, dict) or key not in data:
+            return None
+        data = data[key]
+    return data
+
+
+def valid_command(document):
+    if not isinstance(document, dict):
+        return False
+    if set(document) != {"state", "clientToken"}:
+        return False
+
+    token = document["clientToken"]
+    if not isinstance(token, str) or len(token) != 32:
+        return False
+
+    node = document["state"]
+    for key in ("desired", "seed"):
+        if not isinstance(node, dict) or set(node) != {key}:
+            return False
+        node = node[key]
+
+    path = []
+    while isinstance(node, dict):
+        if len(node) != 1 or len(path) >= 2:
+            return False
+        key, node = next(iter(node.items()))
+        path.append(key)
+
+    return allowed(tuple(path), node)
+
+
+class RestrictedMQTT(ReadOnlyMQTT):
+    @property
+    def required_topics(self):
+        return super().required_topics + [
+            f"$aws/things/{self._thing}/shadow/update/rejected"
+        ]
+
+    async def publish(self, topic, payload, qos=0, retain=False):
+        if topic != f"$aws/things/{self._thing}/shadow/update":
+            return await super().publish(
+                topic, payload, qos=qos, retain=retain
+            )
+
+        try:
+            document = json.loads(payload)
+        except (ValueError, TypeError, UnicodeError):
+            raise ServiceValidationError(
+                "Ungueltiger S40-Befehl"
+            ) from None
+
+        if retain or not valid_command(document):
+            raise ServiceValidationError(
+                "Dieser S40-Befehl ist nicht freigegeben"
+            )
+
+        await MQTTClient.publish(
+            self, topic, payload, qos=qos, retain=False
+        )
+
+
+class S40ControlCoordinator(S40StatusCoordinator):
+    def __init__(self, hass, session, **kwargs):
+        super().__init__(hass, session, **kwargs)
+        self._pending = None
+        self.last_command = None
+        self.settings_phase = 3
+        self.entry = None
+
+    def setting(self, key):
+        return read_path(
+            self.reported,
+            ("seed", f"stage{self.settings_phase}", key),
+        )
+
+    def set_settings_phase(self, phase):
+        if type(phase) is not int or phase not in (1, 2, 3):
+            raise ServiceValidationError(
+                "Unbekannte Einstellphase"
+            )
+
+        self.settings_phase = phase
+        if self.entry is not None:
+            self.hass.config_entries.async_update_entry(
+                self.entry,
+                options={
+                    **self.entry.options,
+                    "s40_settings_phase": phase,
+                },
+            )
+
+        self.async_set_updated_data(self._build_state_snapshot())
+
+    async def _connect_mqtt(self):
+        await self._disconnect_mqtt_client()
+        device = self.device
+
+        client = RestrictedMQTT(
+            websocket_url=self._mqtt_websocket_url(),
+            thing=device.client_id,
+            topic_prefix=device.topic_prefix,
+            client_id=f"ha-s40-control-{uuid4().hex[:12]}",
+            label="s40-control",
+        )
+
+        self._mqtt_client = client
+        client.add_message_callback(self._handle_mqtt_publish)
+        await client.connect()
+        await self._async_request_shadow_refresh(device.device_id)
+
+    async def async_set_seed_state(self, target):
+        await self.async_command(("state",), target)
+
+    async def async_set_setting(self, key, value):
+        await self.async_command(
+            (f"stage{self.settings_phase}", key), value
+        )
+
+    async def async_command(self, path, value):
+        if not allowed(path, value):
+            raise ServiceValidationError(
+                "Wert oder Funktion nicht freigegeben"
+            )
+
+        flood = path == ("quickAct", "waterTime")
+        stop = value == 0 and (path == ("state",) or flood)
+
+        if (
+            not self.is_mqtt_connected
+            or type(self.shadow_version) is not int
+        ):
+            raise ServiceValidationError(
+                "Keine bestaetigte S40-Verbindung"
+            )
+
+        if not stop and (
+            not self.report_available
+            or self.reported.get("connected") is not True
+        ):
+            raise ServiceValidationError(
+                "Keine aktuelle Geraetemeldung"
+            )
+
+        if flood and value == 600:
+            water = read_path(
+                self.reported,
+                ("seed", "quickAct", "waterTime"),
+            )
+            pump = read_path(
+                self.reported, ("seed", "wtpumpLv")
+            )
+            if (
+                type(water) is not int
+                or water != 0
+                or type(pump) is not int
+                or pump != 0
+            ):
+                raise ServiceValidationError(
+                    "Pumpe oder Flutung aktiv; kein erneuter Start"
+                )
+
+        if self._pending is not None:
+            if not stop:
+                raise ServiceValidationError(
+                    "Ein Befehl wartet noch auf Bestaetigung"
+                )
+            self._pending["error"] = "Durch Stopp abgeloest"
+            self._pending["event"].set()
+            self._pending = None
+        elif (
+            not stop
+            and self.report_available
+            and read_path(self.reported, ("seed",) + path) == value
+        ):
+            return
+
+        summary = {
+            "path": list(path),
+            "value": value,
+            "status": "waiting",
+        }
+        pending = {
+            "path": path,
+            "value": value,
+            "version": self.shadow_version,
+            "token": uuid4().hex,
+            "event": asyncio.Event(),
+            "error": None,
+        }
+        self._pending = pending
+        self.last_command = summary
+
+        seed_patch = value
+        for key in reversed(path):
+            seed_patch = {key: seed_patch}
+
+        document = {
+            "state": {"desired": {"seed": seed_patch}},
+            "clientToken": pending["token"],
+        }
+
+        try:
+            self.async_set_updated_data(
+                self._build_state_snapshot()
+            )
+            await self._mqtt_client.publish(
+                f"$aws/things/{self.device.client_id}/shadow/update",
+                json.dumps(document).encode(),
+                qos=0,
+            )
+            await asyncio.wait_for(
+                pending["event"].wait(), timeout=30
+            )
+
+            if pending["error"]:
+                raise HomeAssistantError(pending["error"])
+
+            summary["status"] = "confirmed"
+
+        except asyncio.TimeoutError:
+            summary["status"] = "unconfirmed"
+            raise HomeAssistantError(
+                "Keine Geraetebestaetigung nach 30 Sekunden. "
+                "App pruefen. Keine automatische Wiederholung."
+            ) from None
+
+        except Exception:
+            summary["status"] = "failed"
+            raise
+
+        finally:
+            if self._pending is pending:
+                self._pending = None
+            self.async_set_updated_data(
+                self._build_state_snapshot()
+            )
+
+    async def _handle_mqtt_publish(self, topic, payload, qos):
+        pending = self._pending
+        base = f"$aws/things/{self.device.client_id}/shadow"
+
+        if pending is not None and len(payload) <= 262144:
+            try:
+                doc = json.loads(payload)
+                if not isinstance(doc, dict):
+                    doc = {}
+
+                if topic == f"{base}/update/rejected":
+                    if doc.get("clientToken") == pending["token"]:
+                        pending["error"] = (
+                            "Die Cloud hat den Befehl abgelehnt"
+                        )
+                        pending["event"].set()
+
+                elif topic in {
+                    f"{base}/get/accepted",
+                    f"{base}/update/accepted",
+                    f"{base}/update/documents",
+                }:
+                    if topic.endswith("/update/documents"):
+                        doc = doc.get("current", {})
+
+                    if isinstance(doc, dict):
+                        version = doc.get("version")
+                        value = read_path(
+                            doc,
+                            ("state", "reported", "seed")
+                            + pending["path"],
+                        )
+
+                        pump_ok = True
+                        if pending["path"] == (
+                            "quickAct", "waterTime"
+                        ):
+                            pump = read_path(
+                                doc,
+                                (
+                                    "state", "reported",
+                                    "seed", "wtpumpLv",
+                                ),
+                            )
+                            expected = (
+                                100 if pending["value"] == 600 else 0
+                            )
+                            pump_ok = (
+                                type(pump) is int
+                                and pump == expected
+                            )
+
+                        if (
+                            type(version) is int
+                            and version > pending["version"]
+                            and version >= self.shadow_version
+                            and type(value) is int
+                            and value == pending["value"]
+                            and pump_ok
+                        ):
+                            pending["event"].set()
+
+            except (ValueError, UnicodeError, RecursionError):
+                pass
+
+        await super()._handle_mqtt_publish(topic, payload, qos)
+
+    def export_report(self):
+        result = super().export_report()
+        result.update({
+            "read_only": False,
+            "patch_version": "s40-control-4",
+            "settings_phase": self.settings_phase,
+            "last_command": (
+                dict(self.last_command)
+                if self.last_command else None
+            ),
+        })
+        return result
