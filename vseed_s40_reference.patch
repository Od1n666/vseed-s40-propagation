+"""Explicit manual flood actions; no commands during setup."""
+from homeassistant.components.button import ButtonEntity
+
+from .const import DOMAIN
+from .s40_control import read_path
+from .s40_entities import S40Entity
+
+
+async def async_setup_entry(hass, entry, async_add_entities):
+    coordinator = hass.data[DOMAIN][entry.entry_id].coordinator
+    async_add_entities([
+        S40FloodButton(
+            coordinator,
+            600,
+            "Manuell fluten",
+            "mdi:water-pump",
+        ),
+        S40FloodButton(
+            coordinator,
+            0,
+            "Flutung stoppen",
+            "mdi:water-pump-off",
+        ),
+    ])
+
+
+class S40FloodButton(S40Entity, ButtonEntity):
+    def __init__(self, coordinator, duration, name, icon):
+        super().__init__(
+            coordinator, f"flood_{duration}", name, icon
+        )
+        self.duration = duration
+
+    @property
+    def available(self):
+        coordinator = self.coordinator
+
+        if self.duration == 0:
+            return (
+                coordinator.is_mqtt_connected
+                and type(coordinator.shadow_version) is int
+            )
+
+        water = read_path(
+            coordinator.reported,
+            ("seed", "quickAct", "waterTime"),
+        )
+        pump = read_path(
+            coordinator.reported,
+            ("seed", "wtpumpLv"),
+        )
+
+        return (
+            coordinator.report_available
+            and coordinator.reported.get("connected") is True
+            and coordinator._pending is None
+            and type(water) is int
+            and water == 0
+            and type(pump) is int
+            and pump == 0
+        )
+
+    async def async_press(self):
+        await self.coordinator.async_command(
+            ("quickAct", "waterTime"),
+            self.duration,
+        )
