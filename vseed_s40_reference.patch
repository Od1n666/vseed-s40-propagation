+"""S40 sensors, phase settings and manual flood controls."""
+from homeassistant.const import Platform
+from homeassistant.exceptions import ConfigEntryNotReady
+from homeassistant.helpers import config_validation as cv
+from homeassistant.helpers.aiohttp_client import async_get_clientsession
+
+from .const import DOMAIN
+from .models import RuntimeData
+from .s40_control import S40ControlCoordinator
+
+
+CONFIG_SCHEMA = cv.config_entry_only_config_schema(DOMAIN)
+
+PLATFORMS = [
+    Platform.SENSOR,
+    Platform.SELECT,
+    Platform.NUMBER,
+    Platform.SWITCH,
+    Platform.BUTTON,
+]
+
+
+async def async_setup(hass, config):
+    hass.data.setdefault(DOMAIN, {})
+    return True
+
+
+async def async_setup_entry(hass, entry):
+    coordinator = S40ControlCoordinator(
+        hass,
+        async_get_clientsession(hass),
+        email=entry.data["email"],
+        password=entry.data["password"],
+    )
+    coordinator.entry = entry
+
+    phase = entry.options.get("s40_settings_phase", 3)
+    coordinator.settings_phase = (
+        phase
+        if type(phase) is int and phase in (1, 2, 3)
+        else 3
+    )
+
+    try:
+        await coordinator.async_start()
+    except Exception as err:
+        await coordinator.async_shutdown()
+        raise ConfigEntryNotReady(
+            f"S40 startup failed: {type(err).__name__}"
+        ) from None
+
+    hass.data.setdefault(DOMAIN, {})[entry.entry_id] = RuntimeData(
+        entry_id=entry.entry_id,
+        coordinator=coordinator,
+    )
+
+    try:
+        await hass.config_entries.async_forward_entry_setups(
+            entry, PLATFORMS
+        )
+    except Exception:
+        await coordinator.async_shutdown()
+        hass.data[DOMAIN].pop(entry.entry_id, None)
+        raise
+
+    return True
+
+
+async def async_unload_entry(hass, entry):
+    if not await hass.config_entries.async_unload_platforms(
+        entry, PLATFORMS
+    ):
+        return False
+
+    runtime = hass.data.get(DOMAIN, {}).pop(entry.entry_id, None)
+    if runtime and runtime.coordinator:
+        await runtime.coordinator.async_shutdown()
+
+    return True
