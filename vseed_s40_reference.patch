+"""Enable light or scheduled irrigation in the selected stored phase."""
+from homeassistant.components.switch import SwitchEntity
+
+from .const import DOMAIN
+from .s40_entities import S40Entity
+
+
+async def async_setup_entry(hass, entry, async_add_entities):
+    co = hass.data[DOMAIN][entry.entry_id].coordinator
+    async_add_entities([
+        S40Switch(
+            co, "lgtEn", "Phasenlicht", "mdi:lightbulb-outline"
+        ),
+        S40Switch(
+            co, "pumpEn", "Phasenbewaesserung", "mdi:water-sync"
+        ),
+    ])
+
+
+class S40Switch(S40Entity, SwitchEntity):
+    def __init__(self, coordinator, key, name, icon):
+        super().__init__(
+            coordinator, f"setting_{key}", name, icon
+        )
+        self.key = key
+
+    @property
+    def is_on(self):
+        value = self.coordinator.setting(self.key)
+        if type(value) is int and value in (0, 1):
+            return value == 1
+        return None
+
+    async def async_turn_on(self, **kwargs):
+        await self.coordinator.async_set_setting(self.key, 1)
+
+    async def async_turn_off(self, **kwargs):
+        await self.coordinator.async_set_setting(self.key, 0)
