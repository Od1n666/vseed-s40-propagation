new file mode 100644
index 0000000..3556cf8
--- /dev/null
+++ b/examples/vseed_s40_local_reference/s40_status.py
@@ -0,0 +1,199 @@
+"""Read-only S40 state and periodically refreshed climate telemetry."""
+
+from copy import deepcopy
+from datetime import datetime, timezone
+import json
+import time
+
+from .vseed_readonly import S40Coordinator, scrub
+from .s40_pointlog import fetch_point_log
+
+
+def merge(target, patch):
+    for key, value in patch.items():
+        if value is None:
+            target.pop(key, None)
+        elif isinstance(value, dict):
+            if not isinstance(target.get(key), dict):
+                target[key] = {}
+
+            merge(target[key], value)
+        else:
+            target[key] = deepcopy(value)
+
+
+class S40StatusCoordinator(S40Coordinator):
+    def __init__(self, hass, session, **kwargs):
+        super().__init__(hass, session, **kwargs)
+
+        self.reported = {}
+        self.report_received_at = None
+        self.shadow_version = None
+        self._received_monotonic = None
+
+        self.telemetry = {
+            "sample_time": None,
+            "values": {},
+        }
+        self.telemetry_error = None
+        self._telemetry_busy = False
+        self._next_telemetry_attempt = 0
+
+    @property
+    def report_available(self):
+        return (
+            self.is_mqtt_connected
+            and self._received_monotonic is not None
+            and time.monotonic() - self._received_monotonic < 180
+        )
+
+    async def _refresh_point_log(self):
+        if (
+            self._tokens is None
+            or self._telemetry_busy
+            or time.monotonic() < self._next_telemetry_attempt
+        ):
+            return
+
+        self._telemetry_busy = True
+        self._next_telemetry_attempt = time.monotonic() + 60
+
+        try:
+            sample = await fetch_point_log(
+                self._api,
+                self._tokens,
+                self.device,
+            )
+
+            old_time = self.telemetry.get("sample_time") or 0
+
+            if (sample.get("sample_time") or 0) >= old_time:
+                self.telemetry = sample
+
+            self.telemetry_error = None
+
+        except Exception as err:
+            self.telemetry_error = type(err).__name__
+
+        finally:
+            self._telemetry_busy = False
+
+    def telemetry_available(self, key):
+        stamp = self.telemetry.get("sample_time")
+
+        return (
+            stamp is not None
+            and -60 <= time.time() - stamp <= 300
+            and self.telemetry.get("values", {}).get(key) is not None
+        )
+
+    async def _async_update_data(self):
+        await self._refresh_point_log()
+
+        if self.is_mqtt_connected:
+            await self._async_request_shadow_refresh(
+                self.device.device_id
+            )
+
+        return self._build_state_snapshot()
+
+    async def _handle_mqtt_publish(
+        self,
+        topic,
+        payload,
+        qos,
+    ):
+        await super()._handle_mqtt_publish(
+            topic,
+            payload,
+            qos,
+        )
+
+        base = f"$aws/things/{self.device.client_id}/shadow"
+
+        allowed = {
+            f"{base}/get/accepted",
+            f"{base}/update/accepted",
+            f"{base}/update/documents",
+        }
+
+        if topic not in allowed or len(payload) > 262144:
+            return
+
+        try:
+            document = json.loads(payload)
+
+            if not isinstance(document, dict):
+                return
+
+            if topic.endswith("/update/documents"):
+                document = document.get("current")
+
+            if not isinstance(document, dict):
+                return
+
+            state = document.get("state")
+
+            reported = (
+                state.get("reported")
+                if isinstance(state, dict)
+                else None
+            )
+
+            if not isinstance(reported, dict):
+                return
+
+            version = document.get("version")
+
+            if type(version) is not int:
+                return
+
+            if (
+                self.shadow_version is not None
+                and version < self.shadow_version
+            ):
+                return
+
+            safe = scrub(reported)
+
+        except (
+            ValueError,
+            UnicodeError,
+            RecursionError,
+        ):
+            return
+
+        if topic.endswith("/update/accepted"):
+            merge(self.reported, safe)
+        else:
+            self.reported = safe
+
+        self.shadow_version = version
+
+        self.report_received_at = datetime.now(
+            timezone.utc
+        ).isoformat()
+
+        self._received_monotonic = time.monotonic()
+
+        await self._refresh_point_log()
+
+        self.async_set_updated_data(
+            self._build_state_snapshot()
+        )
+
+    def export_report(self):
+        result = super().export_report()
+
+        result.update(
+            {
+                "patch_version": "s40-readonly-4",
+                "report_received_at": self.report_received_at,
+                "shadow_version": self.shadow_version,
+                "reported": deepcopy(self.reported),
+                "telemetry": deepcopy(self.telemetry),
+                "telemetry_error": self.telemetry_error,
+            }
+        )
+
+        return result
