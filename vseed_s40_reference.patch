+"""Operating phase, local editing phase and stored irrigation mode."""
+from homeassistant.components.select import SelectEntity
+from homeassistant.exceptions import ServiceValidationError
+
+from .const import DOMAIN
+from .s40_control import OPERATIONS, PHASES, read_path
+from .s40_entities import S40Entity
+
+PUMP_MODES = {
+    "Lichtabhaengig": 1,
+    "Benutzerdefinierter Zeitplan": 2,
+}
+
+
+async def async_setup_entry(hass, entry, async_add_entities):
+    co = hass.data[DOMAIN][entry.entry_id].coordinator
+    async_add_entities([
+        S40Select(co, "operation", "Betrieb", OPERATIONS),
+        S40Select(co, "settings_phase", "Einstellphase", PHASES),
+        S40Select(
+            co, "pump_mode", "Bewaesserungsmodus", PUMP_MODES
+        ),
+    ])
+
+
+class S40Select(S40Entity, SelectEntity):
+    def __init__(self, coordinator, kind, name, options):
+        super().__init__(
+            coordinator, kind, name, "mdi:sprout"
+        )
+        self.kind = kind
+        self.options_map = options
+        self._attr_options = list(options)
+
+    @property
+    def available(self):
+        if self.kind == "settings_phase":
+            return True
+        if self.kind == "operation":
+            return self.coordinator.is_mqtt_connected
+        return super().available
+
+    @property
+    def current_option(self):
+        if self.kind == "settings_phase":
+            value = self.coordinator.settings_phase
+        elif not self.coordinator.report_available:
+            return None
+        elif self.kind == "operation":
+            value = read_path(
+                self.coordinator.reported, ("seed", "state")
+            )
+        else:
+            value = self.coordinator.setting("pumpMode")
+
+        if type(value) is not int:
+            return None
+        return next(
+            (
+                name for name, code in self.options_map.items()
+                if code == value
+            ),
+            None,
+        )
+
+    async def async_select_option(self, option):
+        if option not in self.options_map:
+            raise ServiceValidationError("Unbekannte Auswahl")
+        value = self.options_map[option]
+
+        if self.kind == "settings_phase":
+            self.coordinator.set_settings_phase(value)
+        elif self.kind == "operation":
+            await self.coordinator.async_set_seed_state(value)
+        else:
+            await self.coordinator.async_set_setting(
+                "pumpMode", value
+            )
