new file mode 100644
index 0000000..13c5f04
--- /dev/null
+++ b/examples/vseed_s40_local_reference/s40_pointlog.py
@@ -0,0 +1,106 @@
+"""Read S40 telemetry via the verified scene-less history request."""
+
+import math
+import time
+
+from .const import API_POINT_LOG_PATH
+
+# Divisor and permitted range in display units.
+METRICS = {
+    "rTemp": (100, -50, 100),
+    "pTemp": (100, -50, 100),
+    "pHumi": (100, 0, 100),
+    "pVpd": (100, 0, 20),
+    "rssi": (1, -150, 0),
+}
+
+
+def number(value):
+    if isinstance(value, bool) or not isinstance(
+        value, (int, float, str)
+    ):
+        return None
+
+    try:
+        result = float(value)
+    except (ValueError, OverflowError):
+        return None
+
+    return result if math.isfinite(result) else None
+
+
+def parse_point_log(data, now):
+    rows = (
+        data.get("iotDataLogList")
+        if isinstance(data, dict)
+        else None
+    )
+
+    if not isinstance(rows, list):
+        raise ValueError("Unexpected point-log schema")
+
+    candidates = []
+
+    for row in rows:
+        if not isinstance(row, dict):
+            continue
+
+        stamp = number(row.get("time"))
+
+        if stamp is not None and 0 < stamp <= now + 60:
+            candidates.append((stamp, row))
+
+    if not candidates:
+        return {
+            "sample_time": None,
+            "values": {},
+            "row_count": len(rows),
+        }
+
+    stamp, latest = max(
+        candidates,
+        key=lambda item: item[0],
+    )
+
+    values = {}
+
+    for key, (divisor, low, high) in METRICS.items():
+        raw = number(latest.get(key))
+
+        value = (
+            None
+            if raw is None or raw == -6666
+            else raw / divisor
+        )
+
+        values[key] = (
+            round(value, 2)
+            if value is not None and low <= value <= high
+            else None
+        )
+
+    return {
+        "sample_time": int(stamp),
+        "values": values,
+        "row_count": len(rows),
+    }
+
+
+async def fetch_point_log(api, tokens, device):
+    end = int(time.time())
+
+    data = await api._request_json(
+        "POST",
+        API_POINT_LOG_PATH,
+        headers=api._auth_headers(tokens),
+        json_body={
+            "deviceId": device.device_id,
+            "startTime": end - 600,
+            "endTime": end,
+            "reportType": 0,
+            "orderBy": "asc",
+            "timeLevel": "ONE_MINUTE",
+        },
+    )
+
+    return parse_point_log(data, end)
