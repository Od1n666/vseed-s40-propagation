diff --git a/examples/vseed_s40_local_reference/vseed_readonly.py b/examples/vseed_s40_local_reference/vseed_readonly.py
new file mode 100644
index 0000000..3be0517
--- /dev/null
+++ b/examples/vseed_s40_local_reference/vseed_readonly.py
@@ -0,0 +1,292 @@
+"""Exact VSSBS40 discovery plus guarded MQTT read-only capture."""
+
+from collections import deque
+from copy import deepcopy
+from datetime import datetime, timezone
+import json
+import math
+import re
+from uuid import uuid4
+
+from homeassistant.exceptions import ServiceValidationError
+
+from .api import VivosunApiClient
+from .coordinator import VivosunCoordinator
+from .exceptions import VivosunResponseError
+from .models import DeviceInfo, client_model_token
+from .mqtt_client import MQTTClient
+
+MODEL = "VSSBS40"
+
+
+def scrub(value, depth=0):
+    """Keep protocol structure and numbers; exclude string values and IDs."""
+
+    if depth > 8:
+        return "[depth limit]"
+
+    if isinstance(value, dict):
+        result = {}
+
+        for index, (key, child) in enumerate(
+            list(value.items())[:100]
+        ):
+            key = str(key)
+
+            if not re.fullmatch(
+                r"[A-Za-z_][A-Za-z0-9_]{0,39}",
+                key,
+            ):
+                key = f"redacted_key_{index}"
+
+            if any(
+                part in key.lower()
+                for part in (
+                    "token",
+                    "password",
+                    "secret",
+                    "credential",
+                    "email",
+                    "clientid",
+                    "deviceid",
+                    "userid",
+                    "identity",
+                    "serial",
+                    "topic",
+                    "address",
+                    "ssid",
+                    "mac",
+                    "signature",
+                )
+            ):
+                result[key] = "[redacted]"
+            else:
+                result[key] = scrub(child, depth + 1)
+
+        return result
+
+    if isinstance(value, list):
+        return [
+            scrub(child, depth + 1)
+            for child in value[:50]
+        ]
+
+    if value is None or isinstance(value, (bool, int)):
+        return value
+
+    if isinstance(value, float):
+        return value if math.isfinite(value) else None
+
+    return "[redacted]"
+
+
+class S40Api(VivosunApiClient):
+    def _parse_device_entry(
+        self,
+        device,
+        *,
+        category_key,
+        index,
+    ):
+        client = self._optional_str(device, "clientId") or ""
+
+        if client_model_token(client) != MODEL:
+            return super()._parse_device_entry(
+                device,
+                category_key=category_key,
+                index=index,
+            )
+
+        missing = tuple(
+            key
+            for key in (
+                "name",
+                "deviceId",
+                "clientId",
+                "topicPrefix",
+            )
+            if not self._optional_str(device, key)
+        )
+
+        if missing:
+            self._track_skipped_device(
+                device,
+                category_key=category_key,
+                index=index,
+                missing_fields=missing,
+            )
+            return None
+
+        return DeviceInfo(
+            device_id=device["deviceId"],
+            client_id=client,
+            topic_prefix=device["topicPrefix"],
+            name=device["name"],
+            online=(
+                self._optional_int(
+                    device,
+                    "onlineStatus",
+                    default=0,
+                )
+                == 1
+            ),
+            scene_id=self._optional_scene_id(device) or 0,
+            device_type="vseed",
+            supports_point_log=False,
+        )
+
+
+class ReadOnlyMQTT(MQTTClient):
+    @property
+    def required_topics(self):
+        base = f"$aws/things/{self._thing}/shadow"
+
+        return [
+            f"{base}/get/accepted",
+            f"{base}/get/rejected",
+            f"{base}/update/accepted",
+            f"{base}/update/documents",
+            f"{self._topic_prefix}/channel/app",
+        ]
+
+    async def publish(
+        self,
+        topic,
+        payload,
+        qos=0,
+        retain=False,
+    ):
+        allowed = f"$aws/things/{self._thing}/shadow/get"
+
+        if topic != allowed or payload != b"{}" or retain:
+            raise ServiceValidationError(
+                "S40 read-only: publish blocked"
+            )
+
+        await super().publish(
+            topic,
+            payload,
+            qos=qos,
+            retain=False,
+        )
+
+
+class S40Coordinator(VivosunCoordinator):
+    def __init__(self, hass, session, **kwargs):
+        super().__init__(hass, session, **kwargs)
+
+        self._api = S40Api(session)
+        self._frames = deque(maxlen=30)
+        self._received_count = 0
+
+    def _select_devices(self, devices):
+        selected = [
+            device
+            for device in devices
+            if client_model_token(device.client_id) == MODEL
+        ]
+
+        if len(selected) != 1:
+            raise VivosunResponseError(
+                "This probe requires exactly one VSSBS40"
+            )
+
+        return selected
+
+    async def _connect_mqtt(self):
+        await self._disconnect_mqtt_client()
+
+        device = self.device
+
+        client = ReadOnlyMQTT(
+            websocket_url=self._mqtt_websocket_url(),
+            thing=device.client_id,
+            topic_prefix=device.topic_prefix,
+            client_id=f"ha-s40-readonly-{uuid4().hex[:12]}",
+            label="s40-readonly",
+        )
+
+        self._mqtt_client = client
+        client.add_message_callback(self._handle_mqtt_publish)
+
+        await client.connect()
+        await self._async_request_shadow_refresh(
+            device.device_id
+        )
+
+    async def async_publish_shadow_update(
+        self,
+        *args,
+        **kwargs,
+    ):
+        raise ServiceValidationError(
+            "S40 read-only: control blocked"
+        )
+
+    async def _refresh_point_log(self):
+        return
+
+    async def _refresh_plan_stages(self, **kwargs):
+        return
+
+    async def async_start_support_capture(self, **kwargs):
+        raise ServiceValidationError(
+            "Use the built-in S40 diagnostic capture"
+        )
+
+    async def _handle_mqtt_publish(
+        self,
+        topic,
+        payload,
+        qos,
+    ):
+        device = self.device
+        base = f"$aws/things/{device.client_id}/shadow"
+
+        labels = {
+            f"{base}/get/accepted": "shadow_get_accepted",
+            f"{base}/get/rejected": "shadow_get_rejected",
+            f"{base}/update/accepted": "shadow_update_accepted",
+            f"{base}/update/documents": "shadow_update_documents",
+            f"{device.topic_prefix}/channel/app": "channel_app",
+        }
+
+        label = labels.get(topic)
+
+        if label is None:
+            return
+
+        self._received_count += 1
+
+        frame = {
+            "received_at": datetime.now(
+                timezone.utc
+            ).isoformat(),
+            "kind": label,
+        }
+
+        if len(payload) > 262144:
+            frame["error"] = "payload_too_large"
+        else:
+            try:
+                frame["payload"] = scrub(
+                    json.loads(payload)
+                )
+            except (
+                ValueError,
+                UnicodeError,
+                RecursionError,
+            ):
+                frame["error"] = "invalid_json"
+
+        self._frames.append(frame)
+
+    def export_report(self):
+        return {
+            "read_only": True,
+            "patch_version": "s40-readonly-1",
+            "model": MODEL,
+            "mqtt_connected": self.is_mqtt_connected,
+            "received_count": self._received_count,
+            "frames": deepcopy(list(self._frames)),
+        }
