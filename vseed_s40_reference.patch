+"""Stored phase settings with guarded numeric input."""
+import math
+
+from homeassistant.components.number import NumberEntity, NumberMode
+from homeassistant.const import UnitOfTemperature
+from homeassistant.exceptions import ServiceValidationError
+
+from .const import DOMAIN
+from .s40_entities import S40Entity
+
+
+FIELDS = (
+    (
+        "tTemp", "Zieltemperatur",
+        UnitOfTemperature.CELSIUS,
+        20, 32, 0.1, 100, "mdi:thermometer",
+    ),
+    (
+        "tHumi", "Zielfeuchtigkeit",
+        "%", 1, 99, 1, 100, "mdi:water-percent",
+    ),
+    (
+        "lgtLv", "Lichtintensitaet",
+        "%", 30, 100, 10, 1, "mdi:brightness-6",
+    ),
+    (
+        "lgtOnDur", "Lichtdauer",
+        "h", 0, 24, 0.5, 3600, "mdi:timer-outline",
+    ),
+)
+
+
+async def async_setup_entry(hass, entry, async_add_entities):
+    coordinator = hass.data[DOMAIN][entry.entry_id].coordinator
+    async_add_entities([
+        S40Number(coordinator, *item)
+        for item in FIELDS
+    ])
+
+
+class S40Number(S40Entity, NumberEntity):
+    def __init__(
+        self, coordinator, key, name, unit,
+        low, high, step, scale, icon,
+    ):
+        super().__init__(
+            coordinator, f"setting_{key}", name, icon
+        )
+        self.key = key
+        self.scale = scale
+        self._attr_native_unit_of_measurement = unit
+        self._attr_native_min_value = low
+        self._attr_native_max_value = high
+        self._attr_native_step = step
+        self._attr_mode = NumberMode.BOX
+
+    @property
+    def available(self):
+        return (
+            super().available
+            and not getattr(
+                self.coordinator, "_s40_number_busy", False
+            )
+            and self.coordinator._pending is None
+        )
+
+    @property
+    def native_value(self):
+        value = self.coordinator.setting(self.key)
+        return value / self.scale if type(value) is int else None
+
+    async def async_set_native_value(self, value):
+        if (
+            type(value) not in (int, float)
+            or not math.isfinite(value)
+        ):
+            raise ServiceValidationError(
+                "Ungueltiger Zahlenwert"
+            )
+
+        if not (
+            self._attr_native_min_value
+            <= value
+            <= self._attr_native_max_value
+        ):
+            raise ServiceValidationError(
+                "Wert ausserhalb des Einstellbereichs"
+            )
+
+        steps = value / self._attr_native_step
+        if not math.isclose(
+            steps, round(steps),
+            rel_tol=0, abs_tol=0.000001,
+        ):
+            raise ServiceValidationError(
+                "Schrittweite beachten"
+            )
+
+        coordinator = self.coordinator
+        if (
+            getattr(coordinator, "_s40_number_busy", False)
+            or coordinator._pending is not None
+        ):
+            raise ServiceValidationError(
+                "Bitte die Geraetebestaetigung abwarten"
+            )
+
+        coordinator._s40_number_busy = True
+        try:
+            coordinator.async_set_updated_data(
+                coordinator._build_state_snapshot()
+            )
+            await coordinator.async_set_setting(
+                self.key, round(value * self.scale)
+            )
+        finally:
+            coordinator._s40_number_busy = False
+            coordinator.async_set_updated_data(
+                coordinator._build_state_snapshot()
+            )
