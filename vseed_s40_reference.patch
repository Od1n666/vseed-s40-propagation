+                self._set_shadow_connection_state(device_id, True)
+                updated = True
+        except ShadowParseError:
+            self._logger.debug(
+                "Ignoring malformed MQTT payload for topic %s",
+                redact_identifier(topic),
+                exc_info=True,
+            )
+            return
+        except ValueError:
+            self._logger.debug(
+                "Ignoring non-object MQTT JSON payload for topic %s",
+                redact_identifier(topic),
+                exc_info=True,
+            )
+            return
+
