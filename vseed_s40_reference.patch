@@ -0,0 +1,348 @@
+
+input_boolean:
+  vseed_steckling_automatik:
+    name: VSeed Steckling Automatik
+    icon: mdi:robot
+
+  vseed_steckling_phase_halten:
+    name: VSeed Steckling Phase halten
