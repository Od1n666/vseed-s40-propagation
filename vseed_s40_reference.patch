+        self._topic_prefix_to_device_id.clear()
+        for d in self._devices:
+            self._client_id_to_device_id[d.client_id] = d.device_id
+            if d.topic_prefix:
+                self._topic_prefix_to_device_id[d.topic_prefix] = d.device_id
